{
  "excludePatterns": [
    "**/node_modules/**",
    "**/.git/**",
    "**/dist/**",
    "**/build/**",
    "**/.next/**",
    "**/.venv/**",
    "**/__pycache__/**",
    "**/coverage/**",
    "**/*.min.js",
    "**/*.min.css",
    "**/*.map",
    "**/*.lock",
    "**/package-lock.json",
    "**/*.png", "**/*.jpg", "**/*.jpeg", "**/*.gif", "**/*.svg",
    "**/*.pdf", "**/*.zip",
    "**/tests/fixtures/**",
    "**/*.generated.ts",
    "**/.cursor/**",
    "**/.cursorrules",
    "**/.kiro/**",
    "**/target/**",
    "**/.gradle/**",
    "**/*.class",
    "**/*.jar",
    "**/*.war",
    "**/dependency-reduced-pom.xml",
    "**/*.tsbuildinfo"
  ],
  "compressMode": {
    "stripComments": true,
    "stripWhitespace": true,
    "stripTypes": false
  },
  "maxFileSizeBytes": 150000,
  "priorityFiles": [
    "architecture.md",
    "README.md",
    "src/index.ts",
    "src/App.tsx",
    "src/schema.prisma",
    "src/main.py",
    "pom.xml"
  ],
  "includeExtensions": [
    ".js", ".jsx", ".ts", ".tsx",
    ".py",
    ".java", ".kt",
    ".json", ".yaml", ".yml", ".xml", ".properties", ".gradle",
    ".md",
    ".css", ".scss", ".html",
    ".sql", ".prisma"
  ],
  "outputFile": "context-bundle.xml",
  "reportFile": "token-savings-report.md"
}
